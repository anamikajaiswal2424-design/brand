# Set all in Vercel > Project > Settings > Environment Variables
ADMIN_PASSWORD=replace-with-long-unique-admin-password
SESSION_SECRET=replace-with-random-64-character-secret
GITHUB_TOKEN=github-fine-grained-token-with-contents-read-write
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repository-name
GITHUB_BRANCH=main

# Public checkout settings (payee details are shown to customers)
PAYMENT_UPI_ID=
PAYMENT_PAYEE_NAME=
# Optional Meta/Facebook Pixel numeric ID; no access token needed
META_PIXEL_ID=

# Existing trusted importer database (server-only)
MONGODB_URI=
MONGODB_DB=paytm_db
MONGODB_TRANSACTIONS_COLLECTION=transactions
